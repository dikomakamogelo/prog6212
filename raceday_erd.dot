// RaceDay - Entity Relationship Diagram (Crow's Foot)
// Render: dot -Tpng raceday_erd.dot -o raceday_erd.png
//
// Crow's foot arrow mapping (shape nearest the table is listed first):
//   teetee    = || exactly one
//   crowodot  = o< zero or many
//   crowtee   = |< one or many
//   teeodot   = o| zero or one

digraph RaceDay {
    graph [
        label=<<B>RaceDay - Entity Relationship Diagram</B><BR/>(Crow's Foot)>,
        labelloc=t, fontsize=24, fontname="Helvetica",
        rankdir=LR, splines=polyline, nodesep=0.8, ranksep=1.4, bgcolor="white"
    ];
    node  [shape=plain, fontname="Helvetica", fontsize=11];
    edge  [dir=both, fontname="Helvetica", fontsize=10, color="#1A237E", penwidth=1.3];

    // ---------- Key ----------
    Key [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="4" COLOR="#1A237E">
        <TR><TD ALIGN="LEFT"><B>Key</B></TD></TR>
        <TR><TD ALIGN="LEFT">PK = Primary Key (underlined)   FK = Foreign Key   UQ = Unique</TD></TR>
        <TR><TD ALIGN="LEFT">|| = exactly one   o&lt; = zero or many   |&lt; = one or many   o| = zero or one</TD></TR>
        <TR><TD ALIGN="LEFT">Many-to-many: Users (Participants) M : N Events, resolved by the Enrolments associative entity</TD></TR>
      </TABLE>>];

    // ---------- Entities ----------
    Roles [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1565C0">
        <TR><TD COLSPAN="2" BGCOLOR="#1565C0"><FONT COLOR="white"><B>Roles</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>RoleId</U> : INT</TD></TR>
        <TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">RoleName : NVARCHAR(20)</TD></TR>
      </TABLE>>];

    Users [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1565C0">
        <TR><TD COLSPAN="2" BGCOLOR="#1565C0"><FONT COLOR="white"><B>Users</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>UserId</U> : INT</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">RoleId : INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">FirstName : NVARCHAR(50)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">LastName : NVARCHAR(50)</TD></TR>
        <TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">Email : NVARCHAR(100)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">PasswordHash : NVARCHAR(255)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">PhoneNumber : NVARCHAR(15) NULL</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">DateOfBirth : DATE</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">Gender : NVARCHAR(10) NULL</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">CreatedAt : DATETIME2</TD></TR>
      </TABLE>>];

    Enrolments [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1565C0">
        <TR><TD COLSPAN="2" BGCOLOR="#1565C0"><FONT COLOR="white"><B>Enrolments</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>EnrolmentId</U> : INT</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">ParticipantId : INT</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">CategoryId : INT</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">EventId : INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT"><I>FK (CategoryId, EventId) → Categories</I></TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">RaceNumber : INT NULL</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">Status : NVARCHAR(20)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">EnrolledAt : DATETIME2</TD></TR>
        <TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">(ParticipantId, EventId)</TD></TR>
      </TABLE>>];

    Results [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1565C0">
        <TR><TD COLSPAN="2" BGCOLOR="#1565C0"><FONT COLOR="white"><B>Results</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>ResultId</U> : INT</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK, UQ</B></TD><TD ALIGN="LEFT">EnrolmentId : INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">FinishTime : TIME(0)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">Position : INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">RecordedAt : DATETIME2</TD></TR>
      </TABLE>>];

    EventTypes [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2E7D32">
        <TR><TD COLSPAN="2" BGCOLOR="#2E7D32"><FONT COLOR="white"><B>EventTypes</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>EventTypeId</U> : INT</TD></TR>
        <TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">TypeName : NVARCHAR(20)</TD></TR>
      </TABLE>>];

    Events [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#5E35B1">
        <TR><TD COLSPAN="2" BGCOLOR="#5E35B1"><FONT COLOR="white"><B>Events</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>EventId</U> : INT</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">OrganiserId : INT</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">EventTypeId : INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">Name : NVARCHAR(100)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">Description : NVARCHAR(1000)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">EventDate : DATETIME2</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">Location : NVARCHAR(150)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">Latitude : DECIMAL(9,6) NULL</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">Longitude : DECIMAL(9,6) NULL</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">DistanceKm : DECIMAL(6,2)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">RouteImageUrl : NVARCHAR(500) NULL</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">CreatedAt : DATETIME2</TD></TR>
      </TABLE>>];

    Categories [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#F57C00">
        <TR><TD COLSPAN="2" BGCOLOR="#F57C00"><FONT COLOR="white"><B>Categories</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>CategoryId</U> : INT</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">EventId : INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">Name : NVARCHAR(50)  UQ with EventId</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">CategoryType : NVARCHAR(10) ('Age' | 'Distance')</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">MinAge : INT NULL</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">MaxAge : INT NULL</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">DistanceKm : DECIMAL(6,2) NULL</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">MaxParticipants : INT NULL</TD></TR>
        <TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">(CategoryId, EventId)</TD></TR>
      </TABLE>>];

    // ---------- Layout hints ----------
    { rank=same; Roles; EventTypes; }
    { rank=same; Users; Events; }
    { rank=same; Enrolments; Categories; }
    Key -> Roles [style=invis, dir=none];

    // ---------- Relationships ----------
    Roles      -> Users      [label="1 : M has",           arrowtail=teetee,  arrowhead=crowodot];
    Users      -> Enrolments [label="1 : M enters",        arrowtail=teetee,  arrowhead=crowodot];
    Enrolments -> Results    [label="1 : 0..1 produces",   arrowtail=teetee,  arrowhead=teeodot];
    Users      -> Events     [label="1 : M organises",     arrowtail=teetee, arrowhead=crowodot];
    EventTypes -> Events     [label="1 : M classifies",    arrowtail=teetee,  arrowhead=crowodot];
    Events     -> Categories [label="1 : M offers",        arrowtail=teetee,  arrowhead=crowodot];
    Categories -> Enrolments [label="1 : M selected in",   arrowtail=teetee,  arrowhead=crowodot];
}
